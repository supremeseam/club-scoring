# Build the React app, then serve it with Caddy (automatic HTTPS). Build context: repo root.
FROM node:22-alpine AS build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Sub-path to serve under (e.g. /results); empty serves at the site root. Fixed at build time.
ARG BASE_PATH=""
ENV BASE_PATH=$BASE_PATH
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /src/frontend/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
