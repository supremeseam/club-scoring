# Copy to .env (done automatically on first `npm run dev`). Real environment variables win over this file.

# --- Safe local defaults -------------------------------------------------------
# DEBUG=1 enables dev conveniences. With DEBUG=0 Django REFUSES to start unless SECRET_KEY has been
# changed from the dev default. Logins are password-only (NIST 800-63B AAL1): see docs/AUTHENTICATION.md.
DEBUG=1
# Optional extra: require a TOTP authenticator code at login (needs a TOTP device per user in the admin).
REQUIRE_2FA=0
SECRET_KEY=dev-insecure-secret-key-change-me

# Comma-separated host names Django will serve (production: your domain).
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed only if the site is served from a different origin than the API sees, e.g. https://results.yourclub.org
CSRF_TRUSTED_ORIGINS=

# --- Club branding (no rebuild needed; just restart) -----------------------------
CLUB_NAME=Your Yacht Club
CLUB_SHORT_NAME=
# Product name in the header and browser tab, e.g. Harbor Race Hub
APP_NAME=
CLUB_TAGLINE=
CLUB_WEBSITE=
# Logo shown in the header: a URL, or a path like /logo.png (put the file in frontend/public/).
CLUB_LOGO_URL=
# Mantine color: blue cyan teal green lime yellow orange red pink grape violet indigo
BRAND_COLOR=blue
# Exact colour as #rrggbb (overrides BRAND_COLOR). The whole theme is derived from it.
BRAND_COLOR_HEX=
# The burgee/flag on its own, for small spaces (header, browser tab).
CLUB_BURGEE_URL=
# Link printed in PDF footers.
PUBLIC_URL=http://localhost:5173

# Race times are club-local wall-clock times.
TIME_ZONE=America/New_York

# Admin URL (move it off the default in production).
ADMIN_URL=manage-admin/

# SQLite lives here (./data in development, a volume in production).
# DATA_DIR=

# --- Optional: let Amazon Cognito sign people in (see docs/AUTHENTICATION.md) -------
# Default is password sign-in handled by this app. For Cognito, uncomment and fill in all four.
# AUTH_MODE=cognito
# COGNITO_POOLS=us-west-2_AbCdEf123:appclientid,us-west-2_XyZ987654:otherappclientid
# COGNITO_RC_GROUPS=admins
# COGNITO_SIGN_IN_URL=/members/
# COGNITO_TOKEN_STORAGE_KEYS=ayc.admin.session,ayc.member.session
# The page renews expired tokens by calling Cognito directly, so Caddy's security policy must allow it:
# CSP_CONNECT_EXTRA=https://cognito-idp.us-west-2.amazonaws.com

# --- Production only (compose.yml) ----------------------------------------------
# Site address Caddy serves: a domain for Let's Encrypt, or `localhost` for a local HTTPS test.
SITE_ADDRESS=localhost
# Serve the app under a sub-path of the club's main domain, e.g. /results (no trailing slash). Leave commented out
# to serve it at the site root. The reverse proxy in front (or Caddy) must pass that path through; see docs/RUNBOOK.md.
# BASE_PATH=/results
# After moving under BASE_PATH: forward old links and printed QR codes that use this server's own address to the new
# full address (no trailing slash), e.g. https://example.org/results. Needs BASE_PATH; the API and admin are not redirected.
# LEGACY_REDIRECT_BASE=
# Behind CloudFront: the shared secret CloudFront sends as X-Origin-Verify. With it, Caddy takes the visitor's address
# from CloudFront-Viewer-Address (so login lockouts stay per person); without it that header is never trusted.
# ORIGIN_VERIFY_SECRET=
# S3 bucket for Litestream backups (backup profile only).
LITESTREAM_BUCKET=
LITESTREAM_REGION=us-east-1
