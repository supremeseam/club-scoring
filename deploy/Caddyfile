# The app takes the visitor's address (for login lockouts) from the RIGHT-most X-Forwarded-For entry, so Caddy always
# overwrites whatever the client sent. Never publish the app's port: it trusts this header.
# The two CloudFront headers are removed before the request reaches the app, so a client can never forward them.
(app_proxy) {
	reverse_proxy app:8000 {
		header_up X-Forwarded-For {args[0]}
		header_up -X-Real-IP
		header_up -CloudFront-Viewer-Address
		header_up -X-Origin-Verify
	}
}

# SITE_ADDRESS: a domain (Let's Encrypt certificate, automatic) or "localhost" (Caddy's internal CA).
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		# No inline scripts. Mantine injects style tags/attributes, hence 'unsafe-inline' for styles only.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' {$CSP_CONNECT_EXTRA:}; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Served under a sub-path of the club's main domain (BASE_PATH=/results, no trailing slash)? Strip it here so
	# everything below sees root paths. Unset, the placeholder path matches nothing and requests pass untouched.
	@prefixed path {$BASE_PATH:/__no_base_path__} {$BASE_PATH:/__no_base_path__}/*
	uri @prefixed strip_prefix {$BASE_PATH:/__no_base_path__}

	# Links and printed QR codes made before the app moved under BASE_PATH point at this server's own address. When
	# LEGACY_REDIRECT_BASE (the new full address, e.g. https://example.org/results) is set, forward them there. Never the
	# API, static or brand files or the Django admin, and never anything already under BASE_PATH.
	@legacy {
		expression `{env.BASE_PATH} != "" && {env.LEGACY_REDIRECT_BASE} != ""`
		not path {$BASE_PATH:/__no_base_path__} {$BASE_PATH:/__no_base_path__}/* /api/* /static/* /brand/* /{$ADMIN_URL:manage-admin/}*
	}
	redir @legacy {$LEGACY_REDIRECT_BASE:/__no_redirect__}{uri} 308

	# API and the (relocated) Django admin go to gunicorn.
	@django path /api/* /{$ADMIN_URL:manage-admin/}*
	handle @django {
		# Behind CloudFront every request arrives from CloudFront, so the visitor's address comes from the
		# CloudFront-Viewer-Address header ("ip:port", or "[ipv6]:port"). It is believed only on a request that carries
		# the shared secret CloudFront adds (X-Origin-Verify = ORIGIN_VERIFY_SECRET), and never when no secret is set.
		@viaCloudFront {
			expression `{env.ORIGIN_VERIFY_SECRET} != "" && {http.request.header.X-Origin-Verify} == {env.ORIGIN_VERIFY_SECRET}`
			header_regexp viewer CloudFront-Viewer-Address ^\[?([0-9A-Fa-f:.]+?)\]?:[0-9]+$
		}
		handle @viaCloudFront {
			import app_proxy {http.regexp.viewer.1}
		}
		handle {
			import app_proxy {remote_host}
		}
	}

	handle /static/* {
		uri strip_prefix /static
		root * /static
		file_server
	}

	# Single-page app: unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
